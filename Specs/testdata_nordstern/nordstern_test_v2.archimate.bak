  <folder name="Business" id="id-e4e901edf37d44bba7ae09006d6fb7b9" type="business">
    <element xsi:type="archimate:BusinessActor" name="Buchhaltung" id="id-elem-aad31effebab0b0b"/>
    <element xsi:type="archimate:BusinessActor" name="Controlling" id="id-elem-115d1a5d168ca6a8"/>
    <element xsi:type="archimate:BusinessActor" name="Einkauf" id="id-elem-27894ac64a595423"/>
    <element xsi:type="archimate:BusinessActor" name="Facility Management" id="id-elem-84ab541f35e570f1"/>
    <element xsi:type="archimate:BusinessActor" name="Geschaeftsfuehrung" id="id-elem-0944c82f0fd6db32"/>
    <element xsi:type="archimate:BusinessActor" name="IT-Betrieb" id="id-elem-500e464c26f39715"/>
    <element xsi:type="archimate:BusinessActor" name="Informationssicherheit" id="id-elem-f3555b2a5a55a1bb"/>
    <element xsi:type="archimate:BusinessActor" name="Kundenservice" id="id-elem-cec2d26c7fbf2c8f"/>
    <element xsi:type="archimate:BusinessActor" name="Logistik" id="id-elem-4249f84a35858a85"/>
    <element xsi:type="archimate:BusinessActor" name="Marketing" id="id-elem-4266f0596d46f2da"/>
    <element xsi:type="archimate:BusinessActor" name="Personal" id="id-elem-c16a84f84080e937"/>
    <element xsi:type="archimate:BusinessActor" name="Produktion" id="id-elem-e0f7746ecdf81a91"/>
    <element xsi:type="archimate:BusinessActor" name="Qualitaetsmanagement" id="id-elem-c7a8d024a7e9cc77"/>
    <element xsi:type="archimate:BusinessActor" name="Rechtsabteilung" id="id-elem-f8b551f1441fe174"/>
    <element xsi:type="archimate:BusinessActor" name="Vertrieb" id="id-elem-a89f7f378f96f2e6"/>
    <element xsi:type="archimate:BusinessProcess" name="Anlagenstörung melden" id="id-elem-9f024d404625d67a">
      <documentation>Der Anlagenführer erkennt eine Störung, dokumentiert Symptome und informiert Instandhaltung und Schichtleitung. Kritische Stillstände werden als Incident nachverfolgt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Arbeitszeit korrigieren" id="id-elem-c5cbe35bb50d3374">
      <documentation>Fehlerhafte oder fehlende Arbeitszeiten werden geprüft, mit Führungskräften abgestimmt und korrigiert. Die Änderung fließt in die Entgeltabrechnung ein.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Archivierungsregel ändern" id="id-elem-ca5e00919ba2a75e">
      <documentation>Der Application Owner bewertet eine gewünschte Anpassung an Aufbewahrungsregeln und stimmt sie mit Fachbereich und Recht ab. Nach Freigabe wird die Regel dokumentiert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Auftrag erfassen" id="id-elem-2a96e193073ef880">
      <documentation>Der Vertriebsinnendienst übernimmt bestätigte Angebote oder Webshop-Bestellungen und legt daraus Kundenaufträge an. Bei Rückfragen werden Kundenstammdaten geprüft und ergänzt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Backup Restore testen" id="id-elem-d87d4fedd0584c9e">
      <documentation>Der Backup Administrator wählt ein Testobjekt aus, stellt es in einer Testumgebung wieder her und dokumentiert Ergebnis und Dauer. Auffälligkeiten werden als Aufgabe für den IT-Betrieb erfasst.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Bankkonto abstimmen" id="id-elem-8adca6470fb3109d">
      <documentation>Die Finanzkoordination gleicht eingegangene Zahlungsinformationen mit vorhandenen Vorgängen ab und markiert Klärfälle für die Buchhaltung. Dieser Prozess hat bewusst keinen Owner-Eintrag.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Benutzerkonto anlegen" id="id-elem-f8f55381d5f5deff">
      <documentation>Für neue Mitarbeitende wird ein Standardzugang gemäß HR-Meldung vorbereitet. Das passende Berechtigungsprofil wird übernommen und die Fertigmeldung geht an HR und Führungskraft.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Bestellung auslösen" id="id-elem-8f99e983059b6d81">
      <documentation>Der Einkäufer prüft Bedarfsanforderungen, wählt geeignete Lieferanten aus und löst die Bestellung aus. Bei elektronisch angebundenen Lieferanten wird die Bestellung per EDI übertragen.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Besucher anmelden" id="id-elem-e05574a4263bcef4">
      <documentation>Der Empfang erfasst angekündigte Besucher, informiert den Gastgeber und stellt einen Besucherausweis bereit. Nach Besuchsende wird der Besuch abgeschlossen.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Bewerbung prüfen" id="id-elem-7acc36f6d4696296">
      <documentation>Der Recruiter prüft eingegangene Bewerbungen, stimmt geeignete Profile mit dem Fachbereich ab und lädt Kandidaten zum Gespräch ein. Rückmeldungen werden dokumentiert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Budgetplanung konsolidieren" id="id-elem-2c306a8a82491b82">
      <documentation>Die Fachbereiche liefern Planwerte an das Controlling. Der Controller plausibilisiert die Daten, konsolidiert sie und bereitet Abweichungen für die Freigabe durch die Geschäftsführung auf.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Datenqualitätsprüfung ausführen" id="id-elem-85a3fab1b2b11220">
      <documentation>Der Data Engineer prüft geladene Datenbestände auf Vollständigkeit, Dubletten und auffällige Abweichungen. Fehler werden an die zuständigen Fachbereiche zurückgemeldet.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Datenschutzanfrage bearbeiten" id="id-elem-dfba83561be8a6ce">
      <documentation>Der Datenschutzkoordinator nimmt Anfragen entgegen, klärt Zuständigkeiten und koordiniert die Antwort mit den betroffenen Fachbereichen. Die Bearbeitung wird nachvollziehbar dokumentiert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Druckerstörung beheben" id="id-elem-fc2f4f35c84f102d">
      <documentation>Der Field Service nimmt eine Meldung zu einem Druckerproblem auf, prüft Standort und Gerätedaten und koordiniert die Behebung mit dem zuständigen Dienstleister.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="EDI-Fehler nachbearbeiten" id="id-elem-492c008ad00e6cf5">
      <documentation>Der Integration Specialist prüft fehlerhafte elektronische Bestellnachrichten, ergänzt notwendige Klärinformationen und stimmt die weitere Bearbeitung mit Einkauf und IT-Betrieb ab.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Eingangsrechnung prüfen und buchen" id="id-elem-769aecb0e7f6803f">
      <documentation>Eingehende Lieferantenrechnungen werden geprüft, kontiert und zur Zahlung vorbereitet. 1. Der Kreditorenbuchhalter öffnet die eingegangene Rechnung aus dem zentralen Rechnungseingang. 2. Die Rechnung wird mit Invoice OCR ausgelesen und gegen Bestellung und Wareneingang geprüft. 3. Bei Abweichungen klärt die Buchhaltung den Sachverhalt mit Einkauf oder Fachbereich. 4. Nach Freigabe wird die Rechnung in SAP FI gebucht. 5. Für steuerliche Nachweise wird der Beleg zusätzlich in DATEV Unternehmen Online abgelegt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Firewall-Regel beantragen" id="id-elem-4d3a152ccb9de7e9">
      <documentation>Ein Fachbereich beantragt eine neue Netzwerkfreigabe. Der Netzwerkadministrator prüft Zweck, Zielsysteme und Laufzeit und setzt die Regel nach Freigabe um.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Forecast aktualisieren" id="id-elem-dc88c46c2738f6dc">
      <documentation>Der Forecast wird monatlich auf Basis aktueller Ist-Werte, Vertriebsannahmen und Produktionsprognosen aktualisiert. Der Abteilungsleiter Controlling prüft wesentliche Abweichungen und kommentiert Risiken.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Internes Audit planen" id="id-elem-98ae5978a9104aa6">
      <documentation>Der Audit Lead legt Thema, Termin und beteiligte Bereiche für eine interne Qualitätsprüfung fest. Die Abteilungen erhalten eine kurze Vorbereitungsliste und bestätigen ihre Teilnahme.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Kampagnenfreigabe einholen" id="id-elem-44241746c59076c2">
      <documentation>Der Abteilungsleiter Marketing stimmt eine vorbereitete Kampagne mit Vertrieb und Produktmanagement ab. Kommentare werden gesammelt und die finale Version wird dokumentiert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Kommissionierung planen" id="id-elem-46ce4be921f0b8de">
      <documentation>Der Schichtleiter plant die Kommissionierwellen anhand offener Aufträge, Lagerzonen und Personalverfügbarkeit. Engpässe werden priorisiert und bei Bedarf an den Vertrieb zurückgemeldet.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Kundenangebot erstellen" id="id-elem-ee3ccdbc2ea6288a">
      <documentation>Der Account Manager erfasst die Kundenanforderung, kalkuliert Konditionen und erstellt ein Angebot. Kunden- und Opportunity-Daten werden im CRM gepflegt, Preise und Konditionen kommen aus SAP SD.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Kundenportal-Störung analysieren" id="id-elem-bd1e3d525f177a8e">
      <documentation>Der Incident Coordinator sammelt Hinweise aus Kundenmeldungen, prüft den betroffenen Portalbereich und koordiniert die weitere Klärung mit IT-Betrieb und Fachbereich.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Kundenreklamation bearbeiten" id="id-elem-a8c513f280a051e9">
      <documentation>Der Service Agent nimmt Reklamationen entgegen, dokumentiert Ursache und Auswirkung und bindet bei Qualitätsmängeln das Qualitätsmanagement ein. Der Fall bleibt bis zur Rückmeldung an den Kunden offen.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Kundenstammdaten bereinigen" id="id-elem-cc46a9af4219bf3d">
      <documentation>Der CRM Data Steward prüft doppelte, veraltete oder unvollständige Kundendatensätze und stimmt notwendige Korrekturen mit Vertrieb und Kundenservice ab.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Kündigungsbestätigung erstellen" id="id-elem-ce797022e2d46265">
      <documentation>Der HR Sachbearbeiter erstellt eine formale Bestätigung zu einer Personaländerung und stimmt den Text mit der zuständigen Führungskraft ab. Die Ablage erfolgt nachvollziehbar im Personalprozess.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Lieferanten anlegen" id="id-elem-93913875bce33b63">
      <documentation>Neue Lieferanten werden anhand der Stammdatenanforderung geprüft, ergänzt und im System angelegt. Pflichtangaben wie Steuerdaten, Zahlungsbedingungen und Ansprechpartner werden validiert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Lieferantenbewertung durchführen" id="id-elem-03f663967783bdc2">
      <documentation>Der Supplier Manager bewertet Lieferanten anhand von Qualität, Termintreue und Reklamationen. Ergebnisse werden mit Einkauf und Qualitätsmanagement abgestimmt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Lizenznutzung bewerten" id="id-elem-e117496eb0dcc2af">
      <documentation>Der IT Asset Manager aktualisiert eine Übersicht vorhandener IT-Komponenten und stimmt offene Zuordnungen mit den Fachbereichen ab. Dieser Prozess nennt bewusst keine konkrete unterstützende Anwendung.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Management Reporting vorbereiten" id="id-elem-2f8fffec32de2c0f">
      <documentation>Die Assistenz sammelt Kennzahlen aus den Bereichen, erstellt eine Managementübersicht und stimmt offene Erläuterungen mit Controlling und Bereichsleitungen ab.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Marketingkampagne planen" id="id-elem-ef43c4dc233a27ba">
      <documentation>Der Marketing Manager plant Zielgruppe, Botschaft, Kanäle und Timing einer Kampagne. Inhalte und Freigaben werden mit Vertrieb und Produktmanagement abgestimmt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Maschinenparameter prüfen" id="id-elem-905c5a68b9454f89">
      <documentation>Der Prozessingenieur prüft aktuelle Maschinenparameter und vergleicht sie mit den freigegebenen Sollwerten. Auffälligkeiten werden mit Produktion und Qualität besprochen. Dieser Prozess hat bewusst keinen Owner-Eintrag.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Monatsabschluss durchführen" id="id-elem-915494d10b24a1d7">
      <documentation>Die Buchhaltung sammelt offene Posten, prüft Abgrenzungen und erstellt die Abschlussbuchungen für den Monatsabschluss. Der Leiter Buchhaltung kontrolliert die Ergebnisse und gibt das Reporting frei.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Notfallübung dokumentieren" id="id-elem-f3a95e8574494cba">
      <documentation>Der BCM Manager dokumentiert Ablauf, Teilnehmende und Erkenntnisse einer organisatorischen Notfallübung. Verbesserungsmaßnahmen werden an die zuständigen Bereiche übergeben.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Onboarding durchführen" id="id-elem-ea8fe42c94bbcb86">
      <documentation>Neue Mitarbeitende werden organisatorisch angelegt, erhalten Zugangsdaten und werden den ersten Schulungen zugeordnet. HR koordiniert Fachbereich, IT und Führungskraft.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Passwort zurücksetzen" id="id-elem-d34aa7ac26a8e132">
      <documentation>Der Service Desk nimmt eine Anfrage zur Wiederherstellung des Benutzerzugangs entgegen, prüft die Berechtigung des Anfragenden und dokumentiert die Bearbeitung im Ticketsystem.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Pflichtschulung zuweisen" id="id-elem-15a1e59b4437fa95">
      <documentation>Der Learning Manager ordnet Mitarbeitenden die erforderlichen Schulungen zu und überwacht die fristgerechte Bearbeitung. Führungskräfte erhalten eine Übersicht offener Aufgaben.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Produktdaten veröffentlichen" id="id-elem-8db6143914b7d453">
      <documentation>Der Content Manager pflegt Produkttexte, Bilder und technische Merkmale. Nach Freigabe werden die Daten für den Webshop bereitgestellt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Produktionsauftrag starten" id="id-elem-01c7548c5d016e83">
      <documentation>Der Meister prüft Materialverfügbarkeit, Maschinenstatus und Schichtplanung. Danach wird der Produktionsauftrag freigegeben und an die Fertigung übergeben.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Produktionskennzahlen analysieren" id="id-elem-30388eca660e3bbc">
      <documentation>Der Produktionsleiter analysiert Mengen, Ausschuss und Anlagenverfügbarkeit. Auffällige Entwicklungen werden mit Schichtleitung und Controlling besprochen.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Qualitätsabweichung erfassen" id="id-elem-2eefe74310df53ba">
      <documentation>Abweichungen aus Produktion oder Kundenservice werden erfasst, bewertet und einer Ursachenanalyse zugeordnet. Maßnahmen werden dokumentiert und nachverfolgt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Rahmenvertrag prüfen" id="id-elem-034b88c716c9b8bd">
      <documentation>Die Rechtsabteilung prüft Vertragsentwürfe auf Risiken, Laufzeiten und Freigabepflichten. Änderungen werden dokumentiert und die finale Version wird zur elektronischen Signatur vorbereitet.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Release Deployment freigeben" id="id-elem-1b8cfe83376da514">
      <documentation>Der Change Koordinator prüft geplante Softwareänderungen, sammelt Rückmeldungen der beteiligten Teams und bestätigt den abgestimmten Umsetzungstermin. Ergebnisse und offene Punkte werden dokumentiert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Retourenprozess steuern" id="id-elem-a349b4010eadc3d0">
      <documentation>Der Retourenkoordinator prüft angekündigte Rücksendungen, ordnet Ware dem Kundenauftrag zu und entscheidet über Wiedereinlagerung, Nacharbeit oder Verschrottung.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Risikobewertung aktualisieren" id="id-elem-7453eb2a6e2de34e">
      <documentation>Der Risk Manager aktualisiert bestehende Risikoeinträge, ergänzt Bewertungen und stimmt offene Punkte mit den verantwortlichen Bereichen ab. Dieser Prozess hat bewusst keinen Owner-Eintrag.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Security Incident triagieren" id="id-elem-7d2b6c1c82df749a">
      <documentation>Der Security Analyst bewertet neue Sicherheitsmeldungen, prüft betroffene Systeme und entscheidet über Eskalation oder Schließung. Relevante Ereignisse werden an IT-Betrieb und Fachbereich kommuniziert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Server Monitoring prüfen" id="id-elem-3d0b69dd1cff5901">
      <documentation>Der System Engineer prüft aktive Meldungen, bewertet betroffene Systeme und dokumentiert Maßnahmen. Wiederkehrende Auffälligkeiten werden zur Ursachenanalyse weitergegeben.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Spesenabrechnung prüfen" id="id-elem-304afe574d778489">
      <documentation>Die Buchhaltung prüft eingereichte Reisekosten auf Vollständigkeit und formale Richtigkeit. Rückfragen werden mit der reisenden Person geklärt und der Vorgang wird abgeschlossen.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Strategieworkshop vorbereiten" id="id-elem-bbe34a55e93a2548">
      <documentation>Die Geschäftsführung bereitet Ziele, Agenda und Teilnehmerkreis für einen Strategieworkshop vor. Ergebnisse werden später in Maßnahmen überführt.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Ticket priorisieren" id="id-elem-93cbbb45f068b9e5">
      <documentation>Neue Supportfälle werden bewertet, priorisiert und einem Bearbeitungsteam zugewiesen. Kritische Kundenfälle werden durch den Teamleiter eskaliert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Tour disponieren" id="id-elem-9044d98eb3f39f19">
      <documentation>Der Disponent plant Auslieferungstouren auf Basis verfügbarer Fahrzeuge, Liefertermine und Kundenprioritäten. Änderungen werden an Fahrer und Kundenservice kommuniziert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Wareneingang buchen" id="id-elem-65fabc0615ae9e72">
      <documentation>Der Lagermitarbeiter prüft gelieferte Ware gegen Bestellung und Lieferschein. Nach Mengen- und Sichtprüfung wird der Wareneingang gebucht und der Bestand aktualisiert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Wartungsauftrag planen" id="id-elem-e72be594fccd1649">
      <documentation>Der Facility Manager plant regelmäßige Wartungen für Gebäude, Anlagen und technische Ausstattung. Termine, Dienstleister und Rückmeldungen werden zentral dokumentiert.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Zahlungslauf freigeben" id="id-elem-fc9393fb8ca869ab">
      <documentation>Fällige Zahlungen werden selektiert, geprüft und nach Vier-Augen-Prinzip freigegeben. Nach Freigabe wird die Zahlungsdatei an die Bank übertragen.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Zertifikatsablauf prüfen" id="id-elem-3f66c588394c6a55">
      <documentation>Der PKI Administrator prüft anstehende Zertifikatslaufzeiten, informiert betroffene technische Teams und dokumentiert den Status der Erneuerung.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Abteilungsleiter Controlling" id="id-elem-e9de4674c80b56ca"/>
    <element xsi:type="archimate:BusinessRole" name="Abteilungsleiter Marketing" id="id-elem-c6d4d150456cf793"/>
    <element xsi:type="archimate:BusinessRole" name="Account Manager" id="id-elem-1cb57f4cd9726d13"/>
    <element xsi:type="archimate:BusinessRole" name="Anlagenführer" id="id-elem-bcca7c4e1988a3df"/>
    <element xsi:type="archimate:BusinessRole" name="Application Owner" id="id-elem-5552b6be20b13c95"/>
    <element xsi:type="archimate:BusinessRole" name="Assistenz Geschäftsführung" id="id-elem-4202b9d7b07282cc"/>
    <element xsi:type="archimate:BusinessRole" name="Audit Lead" id="id-elem-c42811ec2d1c5c4d"/>
    <element xsi:type="archimate:BusinessRole" name="BCM Manager" id="id-elem-913d43c731f6e546"/>
    <element xsi:type="archimate:BusinessRole" name="Backup Administrator" id="id-elem-9761a88350934eb3"/>
    <element xsi:type="archimate:BusinessRole" name="CRM Data Steward" id="id-elem-7779ef0cd5009b32"/>
    <element xsi:type="archimate:BusinessRole" name="Content Manager" id="id-elem-b69269a6534d78b7"/>
    <element xsi:type="archimate:BusinessRole" name="Controller" id="id-elem-cc83ffaa947885c0"/>
