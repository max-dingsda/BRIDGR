  <folder name="Strategy" id="id-4e99ddb41ad940a5949b3daa64e9b2ae" type="strategy">
    <element xsi:type="archimate:Capability" name="Customer Growth" id="id-elem-bd010415f07cc2b5"/>
    <element xsi:type="archimate:Capability" name="Customer Support" id="id-elem-b6a235e67f1e9f9d"/>
