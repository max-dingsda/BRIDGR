    <element xsi:type="archimate:Capability" name="Governance and Compliance" id="id-elem-ef707fd4ff002353"/>
    <element xsi:type="archimate:Capability" name="Operational Services" id="id-elem-83b457dd8f4bb097"/>
    <element xsi:type="archimate:Capability" name="Production Continuity" id="id-elem-023a5db2430c9af7"/>
    <element xsi:type="archimate:Capability" name="Quality Assurance" id="id-elem-d9b07a8b57ba4549"/>
    <element xsi:type="archimate:Capability" name="Security Oversight" id="id-elem-1e6861b4cd3bd63a"/>
    <element xsi:type="archimate:Capability" name="Strategic Steering" id="id-elem-7894245d90ef3037"/>
    <element xsi:type="archimate:Capability" name="Supply Chain Coordination" id="id-elem-01313ef98a97523c"/>
    <element xsi:type="archimate:Capability" name="Technology Reliability" id="id-elem-c8776755fe819917"/>
