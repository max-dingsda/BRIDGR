@startuml BRIDGR_Klassenmodell
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 13
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

title BRIDGR – UML-Klassenmodell

' ──────────────────────────────────────────────────────────
' PACKAGE: Konfiguration
' ──────────────────────────────────────────────────────────
package "Konfiguration" #FFFDE7 {

  class AppConfig {
    + llm_base_url : str
    + llm_model : str
    + llm_api_key_env : str
    + llm_context_window : int
    + llm_timeout_seconds : int
    + neo4j_url : str
    + neo4j_user : str
    + neo4j_password : str
    + neo4j_database : str
    + fuzzy_threshold : float
    + cmdb_uuid_column : str
    + cmdb_name_column : str
    + cmdb_entity_type_column : str
    + cmdb_server_type_column : str
    + cmdb_owner_name_column : str
    + cmdb_relations_filename : str
    + cmdb_relation_source_column : str
    + cmdb_relation_type_column : str
    + cmdb_relation_target_column : str
    + cmdb_multivalue_separator : str
    + input_path : str
    + cmdb_filename : str
    + output_path : str
    + last_run_mode : str
    + chat_mode : str
    + debug_mode : bool
    --
    + load_config() : AppConfig
    + save_config() : void
  }

  class Neo4jConfig {
    + url : str
    + user : str
    + password : str
    + database : str
  }

  class LlmClientConfig {
    + base_url : str
    + model : str
    + api_key_env : str
    + timeout_seconds : int
    + debug_logger : Callable
  }
}

' ──────────────────────────────────────────────────────────
' PACKAGE: CMDB-Datenmodell
' ──────────────────────────────────────────────────────────
package "CMDB-Datenmodell" #E8F5E9 {

  class CmdbEntity {
    + entity_id : str
    + name : str
    + entity_type : str
    + server_type : str | None
    + owner_name : str | None
    + raw_row : dict | None
    --
    {static} ENTITY_TYPE_APPLICATION : str
    {static} ENTITY_TYPE_INTERFACE : str
    {static} ENTITY_TYPE_PROCESS : str
    {static} ENTITY_TYPE_SERVER : str
  }

  class CmdbRelation {
    + source_id : str
    + relation_type : str
    + target_id : str
    + raw_row : dict | None
  }

  class NormalizedCmdb {
    + entities : list[CmdbEntity]
    + relations : list[CmdbRelation]
  }

  class CmdbValidationIssue {
    + line_number : int
    + message : str
  }

  class CmdbSyncResult {
    + entity_count : int
    + relation_count : int
    + owner_assignment_count : int
    + owner_candidate_count : int
  }

  NormalizedCmdb "1" *-- "0..*" CmdbEntity : entities
  NormalizedCmdb "1" *-- "0..*" CmdbRelation : relations
}

' ──────────────────────────────────────────────────────────
' PACKAGE: Wissensbasis
' ──────────────────────────────────────────────────────────
package "Wissensbasis" #E3F2FD {

  class KnowledgeBase {
    + confirmed : list[ConfirmedLink]
    + rejected : list[RejectedLink]
    + disambiguation : list[dict]
    + process_identity : list[dict]
    + org_units : list[OrgUnitEntry]
    + org_unit_candidates : list[OrgUnitCandidate]
    + role_decisions : list[RoleDecision]
  }

  class ConfirmedLink <<TypedDict>> {
    + prozess : str
    + anwendung_name : str
    + cmdb_id : str
    + resolved_to : str
    + bestaetigt_am : str
    + quelle : str
  }

  class RejectedLink <<TypedDict>> {
    + prozess : str
    + anwendung_name : str
    + cmdb_id : str | None
    + abgelehnt_am : str
  }

  class OrgUnitEntry <<TypedDict>> {
    + name : str
    + created_at : str
    + source : str
  }

  class OrgUnitCandidate <<TypedDict>> {
    + candidate_name : str
    + normalized_name : str
    + source_paths : list[str]
    + process_names : list[str]
    + role_names : list[str]
    + status : str
    + mapped_org_unit : str
    + first_seen : str
    + last_seen : str
  }

  class RoleDecision <<TypedDict>> {
    + role_name : str
    + normalized_name : str
    + status : str
    + decided_at : str
  }

  KnowledgeBase "1" *-- "0..*" ConfirmedLink : confirmed
  KnowledgeBase "1" *-- "0..*" RejectedLink : rejected
  KnowledgeBase "1" *-- "0..*" OrgUnitEntry : org_units
  KnowledgeBase "1" *-- "0..*" OrgUnitCandidate : org_unit_candidates
  KnowledgeBase "1" *-- "0..*" RoleDecision : role_decisions
}

' ──────────────────────────────────────────────────────────
' PACKAGE: Extraktion & Verarbeitung
' ──────────────────────────────────────────────────────────
package "Extraktion & Verarbeitung" #FCE4EC {

  interface Extractor <<Protocol>> {
    + extract(source_path: Path) : ExtractedProcess
  }

  class TextExtractor {
    - prompt_path : Path
    - llm_client : OpenAICompatibleClient
    --
    + extract(source_path: Path) : ExtractedProcess
    # _read_document_text(source_path: Path) : str
    # _to_domain_model(payload, source_path, text) : ExtractedProcess
    # _resolve_process_id(payload, source_path, text) : str
    # _resolve_roles(payload, text) : list[str]
    # _resolve_org_unit_candidates(payload, text) : list[str]
    # _resolve_process_owner_candidate(payload, text) : str
    # _deduplicate_applications(raw) : list[ApplicationReference]
    # _generate_json_with_required_keys(...) : dict
  }

  class PdfExtractor {
    # _read_document_text(source_path: Path) : str
  }

  class DocxExtractor {
    # _read_document_text(source_path: Path) : str
  }

  class BpmnExtractor {
    - prompt_path : Path
    - llm_client : OpenAICompatibleClient
    --
    + extract(source_path: Path) : ExtractedProcess
    # _deduplicate_applications(raw) : list[ApplicationReference]
    # _resolve_process_id(payload, source_path, text) : str
  }

  class ExtractedProcess {
    + process_name : str
    + process_id : str
    + org_unit : str
    + roles : list[str]
    + org_units : list[str]
    + org_unit_candidates : list[str]
    + follows_after : list[str]
    + raw_applications : list[ApplicationReference]
    + applications : list[ApplicationReference]
    + source_path : str
    + process_owner_candidate : str
  }

  class ApplicationReference {
    + name : str
    + confidence : str
  }

  class BpmnTransformer {
    + transform_bpmn_for_import(source_path, target_root) : list[Path]
    - _build_process_transform_text(entry, source_path) : str
    - _extract_process_entries(root) : list[dict]
    - _extract_participant_names_by_process(root) : dict
    - _extract_lane_names(process) : list[str]
    - _extract_application_names(process, names) : set[str]
  }

  Extractor <|.. TextExtractor : implements
  Extractor <|.. BpmnExtractor : implements
  TextExtractor <|-- PdfExtractor : extends
  TextExtractor <|-- DocxExtractor : extends

  ExtractedProcess "1" *-- "0..*" ApplicationReference : applications
}

' ──────────────────────────────────────────────────────────
' PACKAGE: Matching & Review
' ──────────────────────────────────────────────────────────
package "Matching & Review" #F3E5F5 {

  class MatchResult {
    + application_name : str
    + cmdb_id : str | None
    + matched_name : str | None
    + confidence : str
    + source : str
    + score : float
  }

  class ReviewItem {
    + process_name : str
    + application_name : str
    + reason : str
  }

  class GraphWriter {
    + build_payload(process, matches) : GraphWritePayload
    + write_payload(client, payload) : str
    + sync_cmdb(client, normalized_cmdb, assignments) : void
    + write_process_owner(client, org_unit, process_id) : void
    + remove_process_owner(client, process_id) : void
    + write_role_assignment(client, org_unit, role_name) : void
    - _upsert_process_node(client, process_id, name) : str
    - _upsert_cmdb_entity(client, entity) : void
    - _merge_cmdb_relation(client, relation) : void
  }

  class GraphWritePayload {
    + process : ExtractedProcess
    + matches : list[MatchResult]
  }

  GraphWritePayload "1" *-- "1" ExtractedProcess : process
  GraphWritePayload "1" *-- "0..*" MatchResult : matches
}

' ──────────────────────────────────────────────────────────
' PACKAGE: Pipeline & Artefakte
' ──────────────────────────────────────────────────────────
package "Pipeline & Artefakte" #FFF3E0 {

  class Pipeline {
    + run_pipeline(config, input_paths, progress_cb) : PipelineRunResult
    + should_skip_file(run_mode, input_paths, path, hash, prev) : bool
    + build_neo4j_client(config) : Neo4jClient
    + list_bpmn_files(root_path) : list[Path]
    + extract_single_document(extractor, source_path, config) : DocumentRunResult
    + apply_org_unit_mapping(process, kb) : ExtractedProcess
    + build_manual_matches(process_name, apps, confirmed) : list[MatchResult]
  }

  class DocumentRunResult {
    + source_path : str
    + file_hash : str
    + status : str
    + extracted_process : ExtractedProcess | None
    + matches : list[MatchResult]
    + review_items : list[ReviewItem]
    + graph_payload : GraphWritePayload | None
    + process_write_action : str
    + error_message : str | None
  }

  class PipelineRunResult {
    + run_mode : str
    + output_path : str
    + used_output_fallback : bool
    + documents : list[DocumentRunResult]
  }

  class DocumentState {
    + source_path : str
    + file_hash : str
    + process_id : str
  }

  class ImportState {
    + documents : list[DocumentState]
  }

  PipelineRunResult "1" *-- "0..*" DocumentRunResult : documents
  DocumentRunResult "1" o-- "0..1" ExtractedProcess : extracted_process
  DocumentRunResult "1" o-- "0..*" MatchResult : matches
  DocumentRunResult "1" o-- "0..*" ReviewItem : review_items
  DocumentRunResult "1" o-- "0..1" GraphWritePayload : graph_payload
  ImportState "1" *-- "0..*" DocumentState : documents
}

' ──────────────────────────────────────────────────────────
' PACKAGE: Infrastruktur
' ──────────────────────────────────────────────────────────
package "Infrastruktur" #ECEFF1 {

  class Neo4jClient {
    - config : Neo4jConfig
    --
    + execute_write(query, parameters) : list[dict]
    + execute_read(query, parameters) : list[dict]
    + execute_read_unvalidated(query, parameters) : list[dict]
    + ensure_constraints() : void
    + close() : void
    - _execute(query, parameters) : list[dict]
  }

  class OpenAICompatibleClient {
    - config : LlmClientConfig
    --
    + list_models() : list[str]
    + generate_json(system_prompt, user_prompt, required_keys) : dict
    + generate_text(system_prompt, user_prompt) : str
    + generate_chat(messages) : str
    + generate_with_tools(messages, tools) : tuple[str, list[dict]]
    - _generate_content_from_messages(messages, format) : str
    - _validate_required_keys(payload, required_keys) : void
    - _build_json_repair_instruction(required_keys, error) : str
    - _log_debug(event, details) : void
  }

  Neo4jClient ..> Neo4jConfig : uses
  OpenAICompatibleClient ..> LlmClientConfig : uses
}

' ──────────────────────────────────────────────────────────
' PACKAGE: Fehlerbehandlung
' ──────────────────────────────────────────────────────────
package "Fehlerbehandlung" #FFEBEE {

  class Neo4jExecutionError <<Exception>> {}
  class Neo4jConnectionError <<Exception>> {}
  class Neo4jAuthenticationError <<Exception>> {}
  class Neo4jServiceUnavailableError <<Exception>> {}
  class Neo4jQueryError <<Exception>> {}
  class Neo4jQuerySyntaxError <<Exception>> {}
  class QueryValidationError <<Exception>> {}
  class LlmClientError <<Exception>> {}
  class CmdbLoadError <<Exception>> {}
  class TextExtractorError <<Exception>> {}
  class PdfExtractorError <<Exception>> {}
  class DocxExtractorError <<Exception>> {}
  class BpmnTransformError <<Exception>> {}

  Neo4jExecutionError <|-- Neo4jConnectionError
  Neo4jExecutionError <|-- Neo4jQueryError
  Neo4jConnectionError <|-- Neo4jAuthenticationError
  Neo4jConnectionError <|-- Neo4jServiceUnavailableError
  Neo4jQueryError <|-- Neo4jQuerySyntaxError
  TextExtractorError <|-- PdfExtractorError
  TextExtractorError <|-- DocxExtractorError
}

' ──────────────────────────────────────────────────────────
' PACKAGE: Services
' ──────────────────────────────────────────────────────────
package "Services" #E8EAF6 {

  class OrganizationService {
    + persist_org_unit_node(config, name) : void
    + persist_organization_sync(config) : tuple
    + add_org_unit_entry(config, kb, name) : tuple
    + ensure_org_unit_registered(config, name, source) : str
    + map_org_candidate(config, kb, candidate, target) : tuple
    + accept_org_candidate(config, kb, ...) : tuple
    + reject_org_candidate(kb, candidate_name) : tuple
    + load_all_processes_with_owner(config) : list[dict]
    + set_process_owner(config, process_id, org_unit) : tuple
    + clear_process_owner(config, process_id) : tuple
    + load_process_owner_candidates(config) : list[dict]
    + accept_process_owner_candidate(config, ...) : tuple
    + reject_process_owner_candidate(config, ...) : tuple
    + load_unassigned_roles(config) : list[dict]
    + assign_role_to_org_unit(config, role, org_unit) : tuple
    + mark_role_as_role_only(role_name) : tuple
  }

  class QueryService {
    + run_query_chat_turn(question, config) : void
    - _run_prompt_only_turn(...) : tuple
    - _run_tool_use_turn(...) : tuple
    - _build_chat_system_prompt(config) : str
    - _build_llm_history(messages) : list[dict]
    - _extract_cypher_from_response(response) : str
    - _collect_alias_hints(cypher, client) : list[str]
    - _format_query_result(rows, hints) : str
    - _translate_error_for_user(exc) : str
  }

  class CmdbService {
    + persist_cmdb_sync(config) : CmdbSyncResult
    + sync_cmdb_to_neo4j(config, client, kb) : tuple
    + update_organization_knowledge_from_cmdb(kb, cmdb, path) : KnowledgeBase
    + resolve_cmdb_owner_assignments(kb, cmdb) : dict
  }

  class ReviewService {
    + reconstruct_extracted_process(payload) : ExtractedProcess
    + reconstruct_match_result(payload) : MatchResult
    + rerun_single_document_from_artifact(doc, config, ...) : dict
    + persist_single_document_refresh(config, path, ...) : void
    + persist_latest_run_refresh(config, cmdb_rows) : int
    + confirm_review_link(config, process, app, cmdb_id, ...) : tuple
    + reject_review_link(config, process, app, cmdb_id) : tuple
    + save_manual_link(config, kb, process, app, ...) : tuple
  }

  class RuntimeService {
    + build_neo4j_client_key(config) : tuple
    + reset_session_neo4j_client(show_warning) : void
    + get_session_neo4j_client(config) : Neo4jClient
    + write_debug_log(config, event, details) : void
    + get_neo4j_connection_status(config, force) : tuple
    + get_llm_status(config, force) : tuple
    + append_chat_message(role, content, cypher, rows) : void
    + apply_pending_review_scope_defaults(config) : void
    + render_run_feedback(feedback) : void
  }

  class AliasService {
    + normalize_alias_name(value) : str
    + lookup_alias_matches(client, alias_name) : list[dict]
    + sync_knowledge_base_aliases(client, kb) : int
    - _should_skip_alias(alias_name, target_name) : bool
    - _merge_alias_node(client, alias_name) : void
    - _merge_application_alias(...) : void
    - _merge_org_unit_alias(...) : void
  }

  class ImportService {
    + build_import_archive_dir() : Path
    + archive_processed_input_files(root, paths) : tuple
    + finalize_import_artifacts(config, out, root, ...) : tuple
    + build_import_completion_message(duration, ...) : str
  }
}

' ──────────────────────────────────────────────────────────
' PACKAGE: ArchiMate-Integration
' ──────────────────────────────────────────────────────────
package "ArchiMate-Integration" #F1F8E9 {

  class ArchiMateElement {
    + element_id : str
    + element_type : str
    + name : str
    + mapped_label : str | None
  }

  class ArchiMateRelation {
    + relation_id : str
    + relation_type : str
    + source_id : str
    + target_id : str
    + mapped_type : str | None
  }

  class ArchiMateImportResult {
    + element_count : int
    + relation_count : int
    + skipped_count : int
  }

  class ArchiMateExportResult {
    + element_count : int
    + relation_count : int
    + output_path : str
  }

  class ArchiMateImportService {
    + persist_archimate_import(config, source_path) : ArchiMateImportResult
  }

  class ArchiMateExportService {
    + export_graph_as_archimate(config, mapping) : ArchiMateExportResult
  }

  ArchiMateImportService ..> ArchiMateImportResult : produces
  ArchiMateExportService ..> ArchiMateExportResult : produces
}

' ──────────────────────────────────────────────────────────
' PACKAGE: UI-Komponenten
' ──────────────────────────────────────────────────────────
package "UI-Komponenten" #FFF8E1 {

  class ReviewTab {
    + render(config, knowledge_base) : void
  }

  class ConfigTab {
    + render(config) : void
  }

  class OrganizationTab {
    + render(config, knowledge_base) : void
  }

  class QueryTab {
    + render(config) : void
  }

  class ArchiMateTab {
    + render(config) : void
  }

  class UIRunView {
    + summarize_run(latest_run, documents) : dict
    + filter_documents(latest_run, statuses) : list[dict]
    + deduplicate_documents(documents) : list[dict]
    + build_document_status_rows(documents) : list[dict]
    + build_review_rows(documents) : list[dict]
    + build_duplicate_application_warnings(documents) : list[dict]
    + build_document_details(document, config) : dict
    + summarize_review_artifacts(documents, org_candidates) : dict
    + summarize_org_candidate_scope(documents, org_candidates) : dict
  }
}

' ──────────────────────────────────────────────────────────
' PAKETÜBERGREIFENDE ABHÄNGIGKEITEN
' ──────────────────────────────────────────────────────────

' AppConfig erzeugt Unterconfigs
AppConfig ..> Neo4jConfig : creates
AppConfig ..> LlmClientConfig : creates

' Pipeline nutzt alle Kernklassen
Pipeline ..> AppConfig : uses
Pipeline ..> OpenAICompatibleClient : uses
Pipeline ..> Neo4jClient : uses
Pipeline ..> KnowledgeBase : uses
Pipeline ..> NormalizedCmdb : uses
Pipeline ..> Extractor : uses
Pipeline ..> GraphWriter : uses
Pipeline --> PipelineRunResult : produces

' Extraktoren nutzen LLM
TextExtractor ..> OpenAICompatibleClient : uses
BpmnExtractor ..> OpenAICompatibleClient : uses

' GraphWriter nutzt Neo4j und CMDB
GraphWriter ..> Neo4jClient : uses
GraphWriter ..> NormalizedCmdb : uses

' Services nutzen Infrastruktur
QueryService ..> Neo4jClient : uses
QueryService ..> OpenAICompatibleClient : uses
CmdbService ..> Neo4jClient : uses
CmdbService ..> KnowledgeBase : uses
CmdbService ..> NormalizedCmdb : uses
CmdbService --> CmdbSyncResult : produces
OrganizationService ..> Neo4jClient : uses
OrganizationService ..> KnowledgeBase : uses
ReviewService ..> KnowledgeBase : uses
ReviewService ..> AppConfig : uses
AliasService ..> Neo4jClient : uses
AliasService ..> KnowledgeBase : uses
RuntimeService ..> Neo4jClient : uses
RuntimeService ..> AppConfig : uses

' ArchiMate Services
ArchiMateImportService ..> Neo4jClient : uses
ArchiMateExportService ..> Neo4jClient : uses

' UI nutzt Services und Config
ReviewTab ..> ReviewService : uses
OrganizationTab ..> OrganizationService : uses
QueryTab ..> QueryService : uses
ArchiMateTab ..> ArchiMateImportService : uses
ArchiMateTab ..> ArchiMateExportService : uses
ConfigTab ..> AppConfig : uses

@enduml
