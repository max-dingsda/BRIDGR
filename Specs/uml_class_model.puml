@startuml BRIDGR_Klassenmodell
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageFontSize 13
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70

title BRIDGR – Aktualisiertes UML-Klassenmodell

package "Konfiguration & Infrastruktur" #ECEFF1 {
  class AppConfig {
    + llm_base_url : str
    + llm_model : str
    + llm_api_key_env : str
    + llm_context_window : int
    + llm_timeout_seconds : int
    + neo4j_url : str
    + neo4j_user : str
    + neo4j_password : str
    + neo4j_database : str
    + fuzzy_threshold : float
    + input_path : str
    + cmdb_filename : str
    + cmdb_relations_filename : str
    + output_path : str
    + last_run_mode : str
    + chat_mode : str
    + debug_mode : bool
  }

  class Neo4jConfig {
    + url : str
    + user : str
    + password : str
    + database : str
  }

  class LlmClientConfig {
    + base_url : str
    + model : str
    + api_key_env : str
    + timeout_seconds : int
  }

  class Neo4jClient {
    + execute_write(query, parameters) : list[dict]
    + execute_read(query, parameters) : list[dict]
    + execute_read_unvalidated(query, parameters) : list[dict]
    + ensure_constraints() : void
    + close() : void
  }

  class OpenAICompatibleClient {
    + list_models() : list[str]
    + generate_json(system_prompt, user_prompt, required_keys) : dict
    + generate_chat(messages) : str
    + generate_with_tools(messages, tools) : tuple[str, list[dict]]
  }
}

package "Extraktion & Pipeline" #FFF3E0 {
  interface Extractor <<Protocol>> {
    + extract(source_path: Path) : ExtractedProcess
  }

  class TextExtractor {
    + extract(source_path: Path) : ExtractedProcess
  }

  class DocxExtractor
  class PdfExtractor
  class BpmnExtractor {
    + extract(source_path: Path) : ExtractedProcess
  }

  class ApplicationReference {
    + name : str
    + confidence : str
  }

  class ExtractedProcess {
    + process_name : str
    + process_id : str
    + org_unit : str
    + roles : list[str]
    + org_units : list[str]
    + org_unit_candidates : list[str]
    + follows_after : list[str]
    + raw_applications : list[ApplicationReference]
    + applications : list[ApplicationReference]
    + source_path : str
    + process_owner_candidate : str
  }

  class MatchResult {
    + application_name : str
    + cmdb_id : str | None
    + matched_name : str | None
    + confidence : str
    + source : str
    + score : float
  }

  class ReviewItem {
    + process_name : str
    + application_name : str
    + reason : str
  }

  class GraphWritePayload {
    + process : ExtractedProcess
    + matches : list[MatchResult]
  }

  class DocumentRunResult {
    + source_path : str
    + file_hash : str
    + status : str
    + extracted_process : ExtractedProcess | None
    + matches : list[MatchResult]
    + review_items : list[ReviewItem]
    + graph_payload : GraphWritePayload | None
    + process_write_action : str
    + error_message : str | None
  }

  class PipelineRunResult {
    + run_mode : str
    + output_path : str
    + used_output_fallback : bool
    + documents : list[DocumentRunResult]
  }

  class DocumentState {
    + source_path : str
    + file_hash : str
    + process_id : str
  }

  class ImportState {
    + documents : list[DocumentState]
  }
}

package "CMDB & Wissensbasis" #E3F2FD {
  class CmdbEntity {
    + entity_id : str
    + name : str
    + entity_type : str
    + server_type : str | None
    + owner_name : str | None
  }

  class CmdbRelation {
    + source_id : str
    + relation_type : str
    + target_id : str
  }

  class NormalizedCmdb {
    + entities : list[CmdbEntity]
    + relations : list[CmdbRelation]
  }

  class ConfirmedLink <<TypedDict>>
  class RejectedLink <<TypedDict>>
  class OrgUnitEntry <<TypedDict>>
  class OrgUnitCandidate <<TypedDict>>
  class RoleDecision <<TypedDict>>

  class KnowledgeBase {
    + confirmed : list[ConfirmedLink]
    + rejected : list[RejectedLink]
    + disambiguation : list[dict]
    + process_identity : list[dict]
    + org_units : list[OrgUnitEntry]
    + org_unit_candidates : list[OrgUnitCandidate]
    + role_decisions : list[RoleDecision]
  }
}

package "Graph-Schreibmodell & Audit" #F3E5F5 {
  class GraphWriter {
    + build_payload(process, matches) : GraphWritePayload
    + write_payload(client, payload) : str
    + sync_cmdb(client, normalized_cmdb, owner_assignments) : void
    + write_process_owner(client, org_unit_name, process_id) : void
    + remove_process_owner(client, process_id) : void
    + write_role_assignment(client, org_unit_name, role_name) : void
    + promote_candidate_link(client, cmdb_id, process_id, raw_name, matched_name) : void
    + reject_candidate_link(client, cmdb_id, process_id, prozess_name, anwendung_name) : void
    + write_candidate_ownership(client, org_unit_name, entity_id, score) : void
    + merge_archimate_node(client, label, name, archimate_id, archimate_source, archimate_type) : void
    + merge_archimate_relation(client, source_name, source_label, target_name, target_label, bridgr_relation, archimate_rel_type) : void
  }

  class ManualDecision {
    + decision_id : str
    + decision_type : str
    + status : str
    + created_at : str
    + payload_json : str
    + supersedes_decision_id : str | None
    + reverted_at : str | None
    + notes : str | None
  }

  class MergePreview {
    + entity_type : str
    + source_ref : str
    + target_ref : str
    + source_name : str
    + target_name : str
    + source_properties : dict[str, Any]
    + target_properties : dict[str, Any]
    + source_outgoing : list[dict[str, str]]
    + source_incoming : list[dict[str, str]]
    + target_outgoing_keys : list[str]
    + target_incoming_keys : list[str]
    + source_alias_names : list[str]
    + target_alias_names : list[str]
  }
}

package "ArchiMate" #F1F8E9 {
  class ArchiMateElement {
    + element_id : str
    + element_type : str
    + name : str
    + mapped_label : str | None
  }

  class ArchiMateRelation {
    + relation_id : str
    + relation_type : str
    + source_id : str
    + target_id : str
    + mapped_type : str | None
  }

  class ArchiMateImportResult
  class ArchiMateExportResult
}

package "Services" #E8EAF6 {
  class RuntimeService <<module>>
  class QueryService <<module>>
  class ReviewService <<module>>
  class CmdbService <<module>>
  class OrganizationService <<module>>
  class MergeService <<module>>
  class CorrectionService <<module>>
  class DecisionService <<module>>
  class AliasService <<module>>
  class ImportService <<module>>
  class ArchiMateImportService <<module>>
  class ArchiMateExportService <<module>>
}

Extractor <|.. TextExtractor
Extractor <|.. BpmnExtractor
TextExtractor <|-- DocxExtractor
TextExtractor <|-- PdfExtractor

ExtractedProcess "1" *-- "0..*" ApplicationReference
GraphWritePayload "1" *-- "1" ExtractedProcess
GraphWritePayload "1" *-- "0..*" MatchResult
DocumentRunResult "1" o-- "0..1" ExtractedProcess
DocumentRunResult "1" o-- "0..*" MatchResult
DocumentRunResult "1" o-- "0..*" ReviewItem
DocumentRunResult "1" o-- "0..1" GraphWritePayload
PipelineRunResult "1" *-- "0..*" DocumentRunResult
ImportState "1" *-- "0..*" DocumentState
NormalizedCmdb "1" *-- "0..*" CmdbEntity
NormalizedCmdb "1" *-- "0..*" CmdbRelation
KnowledgeBase "1" *-- "0..*" ConfirmedLink
KnowledgeBase "1" *-- "0..*" RejectedLink
KnowledgeBase "1" *-- "0..*" OrgUnitEntry
KnowledgeBase "1" *-- "0..*" OrgUnitCandidate
KnowledgeBase "1" *-- "0..*" RoleDecision

AppConfig ..> Neo4jConfig
AppConfig ..> LlmClientConfig
Neo4jClient ..> Neo4jConfig
OpenAICompatibleClient ..> LlmClientConfig

TextExtractor ..> OpenAICompatibleClient
BpmnExtractor ..> OpenAICompatibleClient
GraphWriter ..> Neo4jClient
GraphWriter ..> NormalizedCmdb
GraphWriter ..> MergePreview

QueryService ..> AppConfig
QueryService ..> OpenAICompatibleClient
QueryService ..> Neo4jClient

ReviewService ..> GraphWriter
ReviewService ..> KnowledgeBase
ReviewService ..> MatchResult
ReviewService ..> ExtractedProcess

CmdbService ..> GraphWriter
CmdbService ..> KnowledgeBase
CmdbService ..> NormalizedCmdb

OrganizationService ..> GraphWriter
OrganizationService ..> KnowledgeBase
OrganizationService ..> ManualDecision

MergeService ..> MergePreview
MergeService ..> ManualDecision
CorrectionService ..> ManualDecision
DecisionService ..> ManualDecision
AliasService ..> KnowledgeBase
ImportService ..> PipelineRunResult

ArchiMateImportService ..> ArchiMateElement
ArchiMateImportService ..> ArchiMateRelation
ArchiMateImportService ..> ArchiMateImportResult
ArchiMateImportService ..> GraphWriter
ArchiMateExportService ..> ArchiMateExportResult
ArchiMateExportService ..> Neo4jClient

@enduml
