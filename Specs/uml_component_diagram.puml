@startuml BRIDGR_Komponentendiagramm
!theme plain
skinparam componentStyle rectangle
skinparam componentFontSize 12
skinparam packageFontSize 13
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60

title BRIDGR – Aktualisiertes UML-Komponentendiagramm

package "Externe Systeme" #FFEBEE {
  component "LLM-Dienst\n(OpenAI-kompatibel)" as LLM
  component "Neo4j\nGraphdatenbank" as NEO4J
  component "Dateisystem\nInput, Output, knowledge_base,\nSpecs, prompts" as FS
}

package "Präsentation" #E3F2FD {
  component "app.py\nStreamlit Entry Point" as APP
  component "query_tab.py\nKommunikation" as UI_QUERY
  component "review_tab.py\nZuordnungen" as UI_REVIEW
  component "config_tab.py\nKonfiguration" as UI_CONFIG
  component "organization_tab.py\nOrganisation" as UI_ORG
  component "archimate_tab.py\nEA-Modell" as UI_ARCH
  component "ui_run_view.py\nRun-/Review-View-Builder" as UI_RUN
  component "dialog_utils.py" as UI_DIALOG
}

package "Service-Schicht" #E8F5E9 {
  component "runtime_service.py\nSession, Status, Live-Feedback" as SVC_RUNTIME
  component "query_service.py\nChat-Orchestrierung" as SVC_QUERY
  component "review_service.py\nReview-Aktionen + Re-Refresh" as SVC_REVIEW
  component "cmdb_service.py\nCMDB-Synchronisation" as SVC_CMDB
  component "organization_service.py\nOrg-/Owner-/Role-Pflege" as SVC_ORG
  component "merge_service.py\nOrg-/Prozess-Merge" as SVC_MERGE
  component "correction_service.py\nUndo manueller Eingriffe" as SVC_CORR
  component "decision_service.py\nManualDecision Audit Log" as SVC_DEC
  component "alias_service.py\nAlias-Projektion" as SVC_ALIAS
  component "import_service.py\nArchivierung + Abschluss" as SVC_IMPORT
  component "archimate_import_service.py" as SVC_ARCH_IN
  component "archimate_export_service.py" as SVC_ARCH_OUT
}

package "Kernlogik" #FFF3E0 {
  component "pipeline.py\nImport-Orchestrierung" as PIPELINE
  component "cmdb.py\nCMDB-Normalisierung" as CMDB
  component "run_artifacts.py\nlatest_run / import_state" as ARTIFACTS
  component "knowledge_base.py\nkb.json-Modell" as KB
  component "bpmn_transformer.py" as BPMN_TRANS
  component "skills.extract\nTXT, DOCX, PDF, BPMN" as EXTRACT
  component "skills.match.py\nMatching / Fuzzy / KB-first" as MATCH
  component "skills.review.py\nReviewItem-Erzeugung" as REVIEW
  component "skills.graph_writer.py\nNeo4j-Schreibmodell" as WRITER
}

package "Core" #F3E5F5 {
  component "app_config.py" as CONFIG
  component "llm_client.py" as LLM_CLIENT
  component "neo4j_utils.py" as NEO4J_CLIENT
  component "graph_schema.py" as GRAPH_SCHEMA
  component "env_loader.py" as ENV
  component "debug_utils.py" as DEBUG
  component "constants.py" as CONST
  component "input_validation.py" as VALIDATION
}

APP --> UI_QUERY
APP --> UI_REVIEW
APP --> UI_CONFIG
APP --> UI_ORG
APP --> UI_ARCH
APP --> ENV

