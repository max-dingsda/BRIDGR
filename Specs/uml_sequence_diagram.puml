@startuml BRIDGR_Sequenzdiagramme
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 180
skinparam sequenceGroupFontSize 12

title Sequenz 1: Dokument-Import-Pipeline

actor Benutzer as User
participant "config_tab.py" as ConfigTab
participant "runtime_service.py" as Runtime
participant "pipeline.py" as Pipeline
participant "cmdb_service.py" as CmdbService
participant "GraphWriter" as Writer
participant "Extractor\n(txt/docx/pdf/bpmn)" as Extractor
participant "OpenAICompatibleClient" as LLM
participant "match.py" as Matcher
participant "review.py" as Reviewer
participant "Neo4jClient" as Neo4j
participant "run_artifacts.py" as Artifacts
participant "import_service.py" as ImportService

User -> ConfigTab : Pipeline starten
ConfigTab -> Runtime : run_pipeline_with_live_feedback(...)
Runtime -> Pipeline : run_pipeline(config, input_paths, progress_callback)
activate Pipeline

Pipeline -> Artifacts : load_import_state(output_path)
Pipeline -> CmdbService : sync_cmdb_to_neo4j(config, neo4j_client, kb)
CmdbService -> Writer : sync_cmdb(normalized_cmdb, owner_assignments)
Writer -> Neo4j : CMDB-Knoten/Relationen schreiben

loop je Eingabedatei
  Pipeline -> Extractor : extract(source_path)
  Extractor -> LLM : generate_json(...)
  LLM --> Extractor : strukturierter Payload
  Extractor --> Pipeline : ExtractedProcess

  Pipeline -> Pipeline : apply_org_unit_mapping(...)

  loop je erkannter Anwendungsbegriff
    Pipeline -> Matcher : match_application_candidates(...)
    Matcher --> Pipeline : list[MatchResult]
  end

  Pipeline -> Reviewer : collect_review_items(process, matches)
  Reviewer --> Pipeline : list[ReviewItem]

  Pipeline -> Writer : build_payload(process, matches)
  Writer --> Pipeline : GraphWritePayload
  Pipeline -> Writer : write_payload(neo4j_client, payload)
  Writer -> Neo4j : Prozess, Rollen,\nDIENT/KOENNTE_DIENEN/FOLGT_AUF

  Pipeline -> Runtime : progress_callback(status)
end

Pipeline -> Artifacts : save_import_state(...)
Pipeline -> Artifacts : write_latest_run(...)
Pipeline -> ImportService : finalize_import_artifacts(...)
ImportService --> Pipeline : Archivpfad + Anzeigeinfos
Pipeline -> Writer : cleanup_process_placeholders()
Pipeline --> Runtime : PipelineRunResult
deactivate Pipeline
Runtime --> ConfigTab : Live-Feedback + Abschlussstatus
ConfigTab --> User : Import-Zusammenfassung

newpage

title Sequenz 2: Natürlichsprachige Graph-Abfrage

actor Benutzer as User2
participant "query_tab.py" as QueryTab
participant "query_service.py" as QueryService
participant "runtime_service.py" as Runtime2
participant "OpenAICompatibleClient" as LLM2
participant "alias_service.py" as AliasService
participant "Neo4jClient" as Neo4j2

User2 -> QueryTab : Frage stellen
QueryTab -> Runtime2 : append_chat_message(user, question)
QueryTab -> QueryService : run_query_chat_turn(question, config)
activate QueryService

QueryService -> Runtime2 : get_session_neo4j_client(config)
QueryService -> LLM2 : generate_chat(...) oder generate_with_tools(...)

alt chat_mode = prompt-only
  LLM2 --> QueryService : Antwort oder ```cypher```-Block
  alt Cypher erzeugt
    loop bis zu 2 Retries
      QueryService -> Neo4j2 : execute_read(cypher_query)
      alt Query ungültig
        Neo4j2 --> QueryService : QueryValidationError / Neo4jQueryError
        QueryService -> LLM2 : Fehlerrückgabe zur Korrektur
        LLM2 --> QueryService : korrigierte Query
      else Query ok
        Neo4j2 --> QueryService : rows
      end
    end
    alt rows leer
      QueryService -> AliasService : lookup_alias_matches(...)
      AliasService -> Neo4j2 : Alias-Lookup
      Neo4j2 --> AliasService : Treffer
      AliasService --> QueryService : alias_hints
    end
    QueryService -> LLM2 : Ergebnisnachricht mit rows/hints
    LLM2 --> QueryService : natürlichsprachige Antwort
  end
else chat_mode = tool-use
  loop bis zu 5 Tool-Aufrufe
    LLM2 --> QueryService : tool_call execute_cypher(query)
    QueryService -> Neo4j2 : execute_read(query)
    Neo4j2 --> QueryService : rows oder Fehler
    QueryService -> LLM2 : tool_result
  end
  LLM2 --> QueryService : finale Antwort
end

QueryService -> Runtime2 : append_chat_message(assistant, content, cypher, rows)
QueryService --> QueryTab : Antwort
deactivate QueryService
QueryTab --> User2 : Chat-Antwort + optionale Query/Rows

newpage

title Sequenz 3: CMDB-Synchronisation

actor Benutzer as User3
participant "config_tab.py" as ConfigTab3
participant "cmdb_service.py" as CmdbService3
participant "cmdb.py" as Cmdb3
participant "knowledge_base.py" as KB3
participant "GraphWriter" as Writer3
participant "review_service.py" as ReviewService3
participant "Neo4jClient" as Neo4j3

User3 -> ConfigTab3 : CMDB synchronisieren
ConfigTab3 -> CmdbService3 : persist_cmdb_sync(config)
activate CmdbService3

CmdbService3 -> KB3 : load_knowledge_base()
CmdbService3 -> Cmdb3 : load_normalized_cmdb(...)
CmdbService3 -> Cmdb3 : optional load_cmdb_relation_rows(...)
CmdbService3 -> Writer3 : load_org_units_from_neo4j()
CmdbService3 -> Writer3 : load_org_unit_aliases_from_neo4j()
CmdbService3 -> CmdbService3 : update_organization_knowledge_from_cmdb(...)
CmdbService3 -> CmdbService3 : resolve_cmdb_owner_assignments(...)
CmdbService3 -> CmdbService3 : resolve_cmdb_owner_candidates(...)
CmdbService3 -> Writer3 : sync_cmdb(...)
Writer3 -> Neo4j3 : Anwendungen, Schnittstellen,\nServer, Prozesse, RUNS_ON, USES_INTERFACE,\nVERANTWORTET
loop für unbekannte Owner
  CmdbService3 -> Writer3 : write_candidate_ownership(...)
  Writer3 -> Neo4j3 : KÖNNTE_VERANTWORTEN
end
CmdbService3 -> KB3 : save_knowledge_base(updated)
CmdbService3 -> ReviewService3 : persist_latest_run_refresh(config, cmdb_rows)
ReviewService3 --> CmdbService3 : refreshed_document_count
CmdbService3 --> ConfigTab3 : CmdbSyncResult
deactivate CmdbService3
ConfigTab3 --> User3 : Sync-Ergebnis

newpage

title Sequenz 4: Review, Merge und Undo

actor Benutzer as User4
participant "review_tab.py / organization_tab.py" as UI4
participant "review_service.py" as Review4
participant "organization_service.py" as Org4
participant "merge_service.py" as Merge4
participant "correction_service.py" as Corr4
participant "decision_service.py" as Decision4
participant "GraphWriter" as Writer4
participant "Neo4jClient" as Neo4j4

User4 -> UI4 : Review-Fall bestätigen
UI4 -> Review4 : confirm_review_link(...)
Review4 -> Writer4 : promote_candidate_link(...)
Writer4 -> Neo4j4 : KÖNNTE_DIENEN -> DIENT
Review4 -> Decision4 : create_manual_decision(confirmed_candidate_link)
Review4 -> Review4 : persist_single_document_refresh(...)
Review4 --> UI4 : Erfolgsmeldung

alt Prozess-Eigentümer setzen
  User4 -> UI4 : Eigentümer zuweisen
  UI4 -> Org4 : set_process_owner(...)
  Org4 -> Writer4 : write_process_owner(...)
  Writer4 -> Neo4j4 : VERANTWORTET schreiben
  Org4 -> Decision4 : create_manual_decision(manual_process_owner_assignment)
  Org4 --> UI4 : Erfolgsmeldung
else Org-/Prozess-Merge
  User4 -> UI4 : Merge ausführen
  UI4 -> Merge4 : merge_org_units(...) / merge_processes(...)
  Merge4 -> Neo4j4 : Beziehungen übertragen,\nAlias schreiben, Quelle löschen
  Merge4 -> Decision4 : create_manual_decision(entity_merge)
  Merge4 --> UI4 : Erfolgsmeldung
else Rücknahme
  User4 -> UI4 : "Zurücknehmen"
  UI4 -> Corr4 : revert_manual_decision(decision_id)
  Corr4 -> Decision4 : get_manual_decision(...)
  Corr4 -> Neo4j4 : fachliche Rücknahme ausführen
  Corr4 -> Decision4 : mark_manual_decision_reverted(...)
  Corr4 -> Decision4 : create_manual_decision(decision_revert)
  Corr4 --> UI4 : Erfolgsmeldung
end

UI4 --> User4 : aktualisierte Ansicht

@enduml
